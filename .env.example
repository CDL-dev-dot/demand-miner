# Reddit 官方 API（免费档，个人研究用途）
# 创建入口: https://www.reddit.com/prefs/apps -> create app -> 选 "script" 类型
# UA 格式建议如实填写: <平台>:<应用名>:<版本> (by u/你的用户名)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=macos:demand-miner:v0.1 (research script by u/YOUR_USERNAME)

# LLM（任意 OpenAI 兼容端点均可：公司网关 / OpenAI / DeepSeek / 本地 Ollama）
# 用公司网关就把 BASE_URL 指到网关地址，MODEL 填网关里的模型名
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# 可选：Firecrawl（阶段 3 的 web 端竞品扫描，不填则自动跳过）
FIRECRAWL_API_KEY=
