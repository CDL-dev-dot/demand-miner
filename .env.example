# Reddit official Data API (free tier, personal research use)
# Create a "script" type app at: https://www.reddit.com/prefs/apps
# User agent convention: <platform>:<app name>:<version> (by u/YOUR_USERNAME)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=macos:demand-miner:v0.1 (research script by u/YOUR_USERNAME)

# LLM backend, one of:
#   openai (default) - any OpenAI-compatible endpoint, fill OPENAI_* below
#   cursor           - use the Cursor CLI with your Cursor subscription, no API key
#                      needed (one-time setup: `cursor-agent login`; optional CURSOR_MODEL)
LLM_BACKEND=
# Cursor backend model pinning (empty = Cursor Auto). Two purposes:
#   CURSOR_MODEL_FAST      - batch extraction/clustering + competitor relevance judge
#   CURSOR_MODEL_REASONING - stage-4 qualitative judgment
# CURSOR_MODEL acts as the fallback for both. Run `cursor-agent --list-models` for ids.
CURSOR_MODEL=
CURSOR_MODEL_FAST=
CURSOR_MODEL_REASONING=

# Only needed when LLM_BACKEND=openai:
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# Optional: Firecrawl (web-side competitor scan in stage 3; skipped automatically if empty)
FIRECRAWL_API_KEY=
